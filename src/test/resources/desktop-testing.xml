<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Demoblaze Desktop Regression Test-Suite" parallel="classes" thread-count="2">
    <parameter name="jenkinsJobName" value="Web-Automation-Suite" />
    <parameter name="jenkinsJobExecutionOrder" value="1" />
    <parameter name="jenkinsJobExecutionMode" value="continue" />
    <parameter name="jenkinsEnvironments" value="QA" />
    <test name="Desktop Chrome Test Execution">
        <parameter name="browser" value="chrome"/>
        <parameter name="selenium_url" value="http://host.docker.internal:4444/wd/hub"/>
        <packages>
            <package name="ua.solvd.demoblaze.common"/>
        </packages>
    </test>
    <test name="Desktop Firefox Test Execution">
        <parameter name="browser" value="firefox"/>
        <parameter name="selenium_url" value="http://host.docker.internal:4445/wd/hub"/>
        <packages>
            <package name="ua.solvd.demoblaze.common"/>
        </packages>
    </test>
</suite>